#!name = Bilibili 签到
#!desc = 定时任务及 Cookie 获取
#!openUrl = http://boxjs.com/#/app/BiliBili.DailyBonus
#!author = MartinsKing[https://github.com/ClydeTime]
#!homepage = https://github.com/ClydeTime/BiliBili
#!icon = https://raw.githubusercontent.com/wanghao6736/proxy-assets/main/icons/Color/mini/bilibili_128.png
#!tag = 签到
#!system = iOS,iPadOS,macOS,tvOS
#!date = 2025-01-31
#!version = 1.2
#!system_version = 15
# 现将获取cookie与定时任务合并为一个模块
# 保持开启,如检测到cookie变更会自动更新,解决cookie经常过期的问题(cookie仍有效不提醒更新)
# 任务奖励：经验值/硬币/大会员积分/年度会员领取B币等
# ================ Boxjs订阅 ================
# 订阅地址：https://raw.githubusercontent.com/ClydeTime/BiliBili/main/boxjs/BiliBili.boxjs.json

[Script]
cron "3 0 * * *" script-path=https://raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js, tag=B站每日等级任务

http-request ^https?:\/\/app\.bilibili\.com\/x\/resource\/fingerprint\? script-path=https://raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js, tag=B站Cookie(APP)

http-request ^https?:\/\/m.bilibili.com/$ script-path=https://raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js, tag=B站Cookie(网页)

[MITM]
hostname = app.bilibili.com, m.bilibili.com